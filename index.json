                            "id": "671",
                            "tc_id": "393",
                            "thread_id": "",
                            "user_id": "1",
                            "message": "Test Case: 1\n\nTest Case Title: Successful Login with Valid Credentials\nModule: Login\nPriority: High\n\nPreconditions:\n- User has a registered Facebook account.\n- User is on the Facebook login page.\n\nTest Steps:\n1. Enter a valid email address in the email or phone field.\n2. Enter the correct password in the password field.\n3. Click the Log In button.\n\nExpected Result:\n- User is redirected to the Facebook home page.\n- User profile picture and news feed are displayed.\n- No error message is shown.\n\n---",
                            "message_type": "replier",
                            "created_at": "2026-09-01 00:14:15",
                            "updated_at": "2026-09-01 00:14:15"
                        }
                    ]
